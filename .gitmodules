[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "JDCruncheR"]
	path = JDCruncheR
	url = https://github.com/inseefr/rjd3qr
[submodule "btb"]
	path = btb
	url = https://github.com/inseefr/btb
[submodule "disaggR"]
	path = disaggR
	url = https://github.com/inseefr/disaggr
[submodule "gustave"]
	path = gustave
	url = https://github.com/inseefr/gustave
[submodule "rjd3production"]
	path = rjd3production
	url = https://github.com/inseefr/rjd3production
[submodule "rjd3qr"]
	path = rjd3qr
	url = https://github.com/inseefr/rjd3qr
